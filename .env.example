# Google OAuth Client ID (Web application). This is a PUBLIC identifier, not a secret.
# Never put a client secret or service-account key in this project.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: the spreadsheet to use. You can also pick or create it inside the app.
VITE_SPREADSHEET_ID=

# Optional no-sign-in mode: URL of your deployed Apps Script web app (apps-script/Code.gs). Needs VITE_SPREADSHEET_ID.
VITE_APPS_SCRIPT_URL=
